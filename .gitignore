# Build artifacts
.build/
build/
dist/
*.app
*.dmg

# Dependencies (rebuilt via scripts/setup_native_deps.sh)
temp_build/

# Python (legacy)
.venv/
__pycache__/
*.pyc
*.spec

# macOS
.DS_Store
*.swp
*~

# Swift Package Manager
.swiftpm/
.swiftpm-cache/

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/

# IDE
.vscode/
.idea/

# Sample data
*.dcm


# workspace
temp.md

# certificate
*.p12
*.cer

# MLX server runtime (PID records and the setup lock, when the server's
# venv sits beside it rather than in Application Support)
mlx-server/.server.pid
mlx-server/.odv-server*.pid
mlx-server/.odv-setup*.lock
mlx-server/.venv-*/

# Cached Python standalone build (downloaded by package_app.sh)
.cache/
# Plugin adapter virtualenvs (created per plugin at install time)
plugins/*/.venv/
plugins/.venv/

# Evaluation data and weights (public, re-fetchable via eval/fetch_data.py)
.eval/

# Packaged app bundle and disk image
*.app/
*.dmg

# Scratch renders and DMG staging (not source)
/_view_*.png
/dmg_tmp/
